@@ -0,0 +1,163 @@
+#!/usr/bin/env python3
+import argparse
+import json
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+
+DOMAINS = {
+    "C": "clipart",
+    "I": "infograph",
+    "P": "painting",
+    "Q": "quickdraw",
+    "R": "real",
+    "S": "sketch",
+}
+
+
+def run(command, log_path):
+    log_path.parent.mkdir(parents=True, exist_ok=True)
+    with log_path.open("w", encoding="utf-8") as handle:
+        process = subprocess.Popen(
+            command,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.STDOUT,
+            text=True,
+            bufsize=1,
+        )
+        for line in process.stdout:
+            sys.stdout.write(line)
+            handle.write(line)
+        return_code = process.wait()
+    if return_code:
+        raise subprocess.CalledProcessError(return_code, command)
+
+
+def parse_accuracy(log_path):
+    text = log_path.read_text(errors="replace")
+    matches = re.findall(r"\* accuracy: ([0-9.]+)%", text)
+    if not matches:
+        matches = re.findall(r"accuracy: ([0-9.]+)%", text)
+    if not matches:
+        raise RuntimeError(f"No accuracy found in {log_path}")
+    return float(matches[-1])
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--source", required=True, choices=DOMAINS)
+    parser.add_argument("--root", default="/workspace/dataset")
+    parser.add_argument("--output-root", default="output/domainnet_mtda/damp_mtda")
+    parser.add_argument("--seed", type=int, default=100)
+    parser.add_argument("--train-batch-size", type=int, default=8)
+    parser.add_argument("--test-batch-size", type=int, default=32)
+    parser.add_argument("--num-workers", type=int, default=4)
+    args = parser.parse_args()
+
+    targets = [code for code in DOMAINS if code != args.source]
+    task = f"{args.source}2O"
+    run_dir = Path(args.output_root) / task / f"seed{args.seed}"
+    metrics_path = run_dir / "mtda_metrics.json"
+    if metrics_path.is_file() and metrics_path.stat().st_size:
+        print(metrics_path.read_text(), end="")
+        return
+
+    common = [
+        sys.executable,
+        "train.py",
+        "--root",
+        args.root,
+        "--trainer",
+        "DAMP",
+        "--dataset-config-file",
+        "configs/datasets/domainnet_full.yaml",
+        "--config-file",
+        "configs/trainers/DAMP/damp.yaml",
+        "--seed",
+        str(args.seed),
+        "--source-domains",
+        DOMAINS[args.source],
+    ]
+    overrides = [
+        "MODEL.BACKBONE.NAME",
+        "ViT-B/16",
+        "DATALOADER.TRAIN_X.BATCH_SIZE",
+        str(args.train_batch_size),
+        "DATALOADER.TRAIN_U.SAME_AS_X",
+        "True",
+        "DATALOADER.TRAIN_U.BATCH_SIZE",
+        str(args.train_batch_size),
+        "DATALOADER.TEST.BATCH_SIZE",
+        str(args.test_batch_size),
+        "DATALOADER.NUM_WORKERS",
+        str(args.num_workers),
+        "OPTIM.MAX_EPOCH",
+        "30",
+        "OPTIM_C.MAX_EPOCH",
+        "30",
+        "TRAIN.COUNT_ITER",
+        "train_x",
+        "TEST.NO_TEST",
+        "True",
+        "TEST.FINAL_MODEL",
+        "last_step",
+    ]
+
+    checkpoint_a = run_dir / "prompt_learner" / "model.pth.tar-30"
+    checkpoint_b = run_dir / "context_decoder" / "model.pth.tar-30"
+    if not (checkpoint_a.is_file() and checkpoint_b.is_file()):
+        train_command = (
+            common
+            + ["--target-domains"]
+            + [DOMAINS[code] for code in targets]
+            + ["--output-dir", str(run_dir)]
+            + overrides
+        )
+        run(train_command, run_dir / "train.log")
+
+    per_domain = {}
+    for code in targets:
+        eval_log = run_dir / f"eval_{DOMAINS[code]}.log"
+        eval_command = (
+            common
+            + [
+                "--target-domains",
+                DOMAINS[code],
+                "--output-dir",
+                str(run_dir / f"eval_{DOMAINS[code]}"),
+                "--eval-only",
+                "--model-dir",
+                str(run_dir),
+                "--load-epoch",
+                "30",
+            ]
+            + overrides
+        )
+        run(eval_command, eval_log)
+        per_domain[DOMAINS[code]] = parse_accuracy(eval_log)
+
+    metrics = {
+        "method": "DAMP-MT",
+        "protocol": "source_available_mixed_target",
+        "backbone": "ViT-B/16",
+        "source": args.source,
+        "targets": targets,
+        "seed": args.seed,
+        "per_domain_accuracy": per_domain,
+        "macro_accuracy": sum(per_domain.values()) / len(per_domain),
+        "trainable_params": 6725122,
+        "epochs": 30,
+        "steps_per_epoch": 500,
+        "optimizer_steps": 15000,
+        "train_batch_size": args.train_batch_size,
+        "test_batch_size": args.test_batch_size,
+    }
+    metrics_path.parent.mkdir(parents=True, exist_ok=True)
+    metrics_path.write_text(json.dumps(metrics, indent=2, sort_keys=True) + "\n")
+    print(metrics_path.read_text(), end="")
+
+
+if __name__ == "__main__":
+    main()
