+import os.path as osp
+from collections import OrderedDict
+
+from dassl.data.datasets import DATASET_REGISTRY, Datum, DatasetBase
+
+
+ALIASES = {
+    "c": "clipart",
+    "clipart": "clipart",
+    "i": "infograph",
+    "infograph": "infograph",
+    "p": "painting",
+    "painting": "painting",
+    "q": "quickdraw",
+    "quickdraw": "quickdraw",
+    "quick_draw": "quickdraw",
+    "r": "real",
+    "real": "real",
+    "real_world": "real",
+    "s": "sketch",
+    "sketch": "sketch",
+}
+
+
+def normalize_domain(name):
+    key = str(name).strip().lower().replace("-", "_").replace(" ", "_")
+    if key not in ALIASES:
+        raise ValueError(f"Unsupported DomainNet domain: {name}")
+    return ALIASES[key]
+
+
+@DATASET_REGISTRY.register()
+class DomainNetFull(DatasetBase):
+    """Full DomainNet-345 using the official train/test lists.
+
+    DAMP receives one labeled source loader and one concatenated unlabeled
+    target loader. ``TARGET_DOMAINS`` may contain all five remaining domains
+    for MTDA training or one domain for checkpoint evaluation.
+    """
+
+    dataset_dir = "DomainNet"
+    domains = ["clipart", "infograph", "painting", "quickdraw", "real", "sketch"]
+    domain_codes = OrderedDict(
+        (domain, code)
+        for domain, code in zip(domains, ["C", "I", "P", "Q", "R", "S"])
+    )
+
+    def __init__(self, cfg):
+        root = osp.abspath(osp.expanduser(cfg.DATASET.ROOT))
+        candidate = osp.join(root, self.dataset_dir)
+        self.dataset_dir = candidate if osp.isdir(candidate) else root
+        self.list_dir = osp.join(self.dataset_dir, "image_list")
+        if not osp.isdir(self.list_dir):
+            raise FileNotFoundError(
+                f'DomainNetFull requires image_list/ below "{self.dataset_dir}"'
+            )
+
+        source_domains = [normalize_domain(d) for d in cfg.DATASET.SOURCE_DOMAINS]
+        if len(source_domains) != 1:
+            raise ValueError(f"Expected one source domain, got {source_domains}")
+        source = source_domains[0]
+        targets = [normalize_domain(d) for d in cfg.DATASET.TARGET_DOMAINS]
+        if not targets:
+            raise ValueError("At least one target domain is required")
+        if source in targets or len(targets) != len(set(targets)):
+            raise ValueError(f"Invalid source/target selection: {source}, {targets}")
+
+        label_to_classname = self._build_global_label_mapping()
+        train_x = self._read_split(source, "train", label_to_classname)
+        train_u = []
+        test = []
+        for target in targets:
+            train_u.extend(self._read_split(target, "train", label_to_classname))
+            test.extend(self._read_split(target, "test", label_to_classname))
+
+        super().__init__(train_x=train_x, train_u=train_u, test=test)
+        self._num_classes = len(label_to_classname)
+        self._lab2cname = dict(label_to_classname)
+        self._classnames = [
+            label_to_classname[label] for label in range(self._num_classes)
+        ]
+
+    def _list_path(self, domain, split):
+        path = osp.join(self.list_dir, f"{domain}_{split}.txt")
+        if not osp.isfile(path):
+            raise FileNotFoundError(f'Missing DomainNet list: "{path}"')
+        return path
+
+    @staticmethod
+    def _parse_line(line, path, line_number):
+        try:
+            relative_path, raw_label = line.rstrip().rsplit(maxsplit=1)
+            return relative_path, int(raw_label)
+        except ValueError as exc:
+            raise ValueError(
+                f"Malformed entry at {path}:{line_number}: {line!r}"
+            ) from exc
+
+    def _build_global_label_mapping(self):
+        mapping = {}
+        for domain in self.domains:
+            for split in ("train", "test"):
+                path = self._list_path(domain, split)
+                with open(path, "r", encoding="utf-8") as handle:
+                    for line_number, line in enumerate(handle, 1):
+                        relative_path, label = self._parse_line(
+                            line, path, line_number
+                        )
+                        classname = (
+                            relative_path.replace("\\", "/")
+                            .split("/")[-2]
+                            .replace("_", " ")
+                            .lower()
+                        )
+                        previous = mapping.setdefault(label, classname)
+                        if previous != classname:
+                            raise ValueError(
+                                f"Inconsistent label {label}: "
+                                f"{previous!r} versus {classname!r}"
+                            )
+        if sorted(mapping) != list(range(345)):
+            raise ValueError(
+                f"Expected canonical labels 0..344, got {len(mapping)} labels"
+            )
+        return mapping
+
+    def _read_split(self, domain, split, label_to_classname):
+        items = []
+        path = self._list_path(domain, split)
+        domain_index = self.domains.index(domain)
+        with open(path, "r", encoding="utf-8") as handle:
+            for line_number, line in enumerate(handle, 1):
+                relative_path, label = self._parse_line(line, path, line_number)
+                impath = osp.join(self.dataset_dir, relative_path)
+                if not osp.isfile(impath):
+                    raise FileNotFoundError(
+                        f'Missing image at {path}:{line_number}: "{impath}"'
+                    )
+                items.append(
+                    Datum(
+                        impath=impath,
+                        label=label,
+                        domain=domain_index,
+                        classname=label_to_classname[label],
+                    )
+                )
+        return items
